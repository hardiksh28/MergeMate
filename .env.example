# MergeMate Environment Variables Template

# GitHub Personal Access Token (Requires 'repo' or 'public_repo' scope to open PRs)
GITHUB_TOKEN=

# Multiple Gemini API Keys for Automatic Key Rotation on 429 Rate Limits
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=

# Optional: Default single key fallback
GEMINI_API_KEY=

# Browser Agent (Playwright + CDP Live Streaming)
# Port for the standalone browser-agent WebSocket server (npm run browser:server)
BROWSER_WS_PORT=8787
# Exposed to the browser so BrowserAgentPanel knows where to connect
NEXT_PUBLIC_BROWSER_WS_URL=ws://localhost:8787
# Set to false to watch the isolated Chromium window instead of running headless
BROWSER_HEADLESS=true
