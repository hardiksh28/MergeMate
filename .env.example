# Copy to .env.local and fill in.

# AI: free key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional model overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# GitHub: any classic token, no scopes needed. Raises the API limit from 60 to 5000 requests/hour.
# https://github.com/settings/tokens/new?description=MergeMate-server
GITHUB_TOKEN=

# GitHub sign-in. Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Any random 32+ char string (encrypts the session cookie): openssl rand -hex 32
SESSION_SECRET=

# MergeCity: the 3D waitlist city (separate app). MergeMate reads its public residents view.
NEXT_PUBLIC_MERGECITY_URL=https://merge-city.vercel.app
# Supabase project behind MergeCity: Project URL + anon (public) key
MERGECITY_SUPABASE_URL=
MERGECITY_SUPABASE_ANON_KEY=

# Google Analytics 4 measurement ID (defaults to MergeMate's property if unset)
NEXT_PUBLIC_GA_ID=G-VNZQPC8TG9

# MergeMate's own data (accounts, activity, admin dashboard). Run supabase/mergemate.sql first.
# Uses MERGECITY_SUPABASE_URL unless MERGEMATE_SUPABASE_URL is set. Service role key = server-only secret.
MERGEMATE_SUPABASE_URL=
MERGEMATE_SUPABASE_SERVICE_KEY=
# GitHub logins allowed into /admin (comma-separated)
ADMIN_GITHUB_LOGINS=hardiksh28
